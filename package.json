{
  "name": "@rflowdapp/rflow",
  "version": "0.2.0",
  "description": "TypeScript SDK for the rFlow Solana protocol — yield discounting + Meteora LP fee deals on Solana mainnet.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:run && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rFlowdapp/rflow-sdk.git"
  },
  "homepage": "https://github.com/rFlowdapp/rflow-sdk#readme",
  "bugs": {
    "url": "https://github.com/rFlowdapp/rflow-sdk/issues"
  },
  "keywords": [
    "solana",
    "anchor",
    "defi",
    "yield",
    "yield-trading",
    "yield-tokenization",
    "rflow",
    "meteora",
    "damm-v2",
    "lst",
    "pyth",
    "blockchain",
    "web3",
    "typescript",
    "sdk"
  ],
  "author": "rFlow Protocol <hello@rflow.app>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@coral-xyz/anchor": ">=0.29.0 <0.33.0",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.90.0"
  },
  "peerDependenciesMeta": {
    "@pythnetwork/hermes-client": {
      "optional": true
    },
    "@pythnetwork/pyth-solana-receiver": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@pythnetwork/hermes-client": "^2.0.0",
    "@pythnetwork/pyth-solana-receiver": "^0.13.0"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@eslint/js": "^9.39.2",
    "@pythnetwork/hermes-client": "^2.1.0",
    "@pythnetwork/pyth-solana-receiver": "^0.13.0",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.52.0",
    "vitest": "^2.0.0"
  }
}
